<?xml version="1.0" encoding="utf-8"?>
<!--
  이 폴더 아래 모든 프로젝트에 자동으로 먼저 적용된다 (Microsoft.Cpp.Default.props가 가져옴).
  CUDA 버전을 바꿀 땐 여기 CudaVersion 한 줄만 고친다.
-->
<Project>
  <PropertyGroup>
    <CudaPracticeRoot>$(MSBuildThisFileDirectory)</CudaPracticeRoot>
    <!-- CUDA 12.9 가 지원하는 MSVC 는 VS 2017~2022 (≤ 14.4x).
         VS 2026 의 기본 컴파일러 14.51 로 빌드하면 cudafe++ 가 크래시한다.
         (nvcc error : 'cudafe++' died with status 0xC0000005)
         플랫폼 툴셋은 v145 그대로 두고 컴파일러 버전만 14.44 로 내린다.
         VS 업데이트로 이 버전이 사라지면 VC\Tools\MSVC 폴더를 보고 번호를 고칠 것.
         CUDA 가 14.5x 를 지원하면 이 줄을 지우면 된다. -->
    <VCToolsVersion>14.44.35207</VCToolsVersion>
    <!-- 설치된 CUDA Toolkit 버전. "CUDA 12.9.props" 파일 이름과 일치해야 한다. -->
    <CudaVersion>12.9</CudaVersion>
    <!-- 내 GPU: RTX 4060 Laptop = CC 8.9 -->
    <CudaArch>sm_89</CudaArch>
    <!-- CUDA 12.9 는 VS 2026 (MSVC 14.5x) 보다 먼저 나와서 nvcc 가 "unsupported compiler" 로 막을 수 있다.
         true 면 -allow-unsupported-compiler 를 붙인다. CUDA 를 올리고 문제 없으면 false 로. -->
    <CudaAllowUnsupportedCompiler>true</CudaAllowUnsupportedCompiler>
  </PropertyGroup>
</Project>
